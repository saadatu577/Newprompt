{
  "manifest_version": 3,
  "name": "LovaRPM",
  "version": "2.9.8",
  "description": "LovaRPM extension for Lovable and Base44 projects, with GitHub as the primary source for code changes.",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "sidePanel",
    "downloads"
  ],
  "host_permissions": [
    "https://lovable.dev/*",
    "https://app.base44.com/*",
    "https://chatgpt.com/*",
    "https://oypjjsyqpnxvkadatkbi.supabase.co/*",
    "https://happy-little101.lovable.app/*"
  ],
  "background": {
    "service_worker": "service-worker-v020.js",
    "type": "module"
  },
  "action": {
    "default_title": "LovaRPM",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.base44.com/apps/*"
      ],
      "js": [
        "base44-github-probe.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://app.base44.com/apps/*"
      ],
      "js": [
        "lovable-context-guard.js",
        "attachments.js",
        "base44.js",
        "lovable-composer-core.js",
        "lovable-attachments.js",
        "lovable-composer.js",
        "lovable-run-monitor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "js": [
        "lovable-page-probe.js",
        "lovable-gitsync-autoprobe.js",
        "lovable-supabase-autoprobe.js",
        "lovable-gitsync-sticky.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://lovable.dev/*"
      ],
      "css": [
        "lovable-legacy-ui.css"
      ],
      "js": [
        "lovable-context-guard.js",
        "attachments.js",
        "lovable.js",
        "lovable-composer-core.js",
        "lovable-attachments.js",
        "lovable-integrations.js",
        "lovable-supabase-state-bridge.js",
        "lovable-composer.js",
        "lovable-run-monitor.js",
        "lovable-logo-refresh.js",
        "lovable-preview-refresh.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "chatgpt-context-guard.js",
        "chatgpt-visibility.js",
        "chatgpt.js",
        "chatgpt-prompt-card.js",
        "chatgpt-attachments.js",
        "chatgpt-enhance.js",
        "chatgpt-activity.js",
        "chatgpt-result-refresh.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "popup.html"
  },
  "key": "",
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "logo.png",
        "logo.svg"
      ],
      "matches": [
        "https://lovable.dev/*",
        "https://app.base44.com/*",
        "https://chatgpt.com/*"
      ]
    }
  ],
  "version_name": "Brazil's best extension, always up to date"
}
